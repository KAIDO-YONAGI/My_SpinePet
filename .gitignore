# 大体积资源镜像（外部来源，可重新拉取），不入库
/resources/

# 本地工具与会话产物
.zcode/*
!.zcode/agents/
!.zcode/agents/**
!.zcode/skills/
!.zcode/skills/**
.fetch-cache/
.codegraph
prompts.txt

# 多 Agent 工作流运行时租约（文档与脚本纳入版本管理）
/Y_MultipleAgentWorkflow/WorkingAgent/*.txt
/Y_MultipleAgentWorkflow/WorkingAgent/_registry.lock
/Y_MultipleAgentWorkflow/WorkingAgent/*.tmp

# 系统杂项
Thumbs.db
desktop.ini

# 自包含打包产物（可重新构建），不入库
/release/
/dist/
