<Window x:Class="SpinePet.Views.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpinePet.Views"
        Title="SpinePet"
        Icon="pack://application:,,,/Assets/Brand/SpinePet.ico"
        Width="468"
        MinWidth="468"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFF2F5FC"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="OnWindowLoaded"
        AutomationProperties.Name="SpinePet configuration panel">
    <Window.InputBindings>
        <KeyBinding Key="F"
                    Modifiers="Control"
                    Command="{x:Static views:MainWindow.FocusCharacterSearchCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Color system -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF11151E" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#FF171C28" />
        <SolidColorBrush x:Key="SectionBrush" Color="#FF1A202D" />
        <SolidColorBrush x:Key="SectionHoverBrush" Color="#FF202838" />
        <SolidColorBrush x:Key="ControlBrush" Color="#FF252D3D" />
        <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF2D374A" />
        <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF1E2533" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF2C3547" />
        <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF46536A" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF8B7CF6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFA89BFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2D8B7CF6" />
        <SolidColorBrush x:Key="InfoBrush" Color="#FF63D8FF" />
        <SolidColorBrush x:Key="InfoSoftBrush" Color="#1F63D8FF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADEA2" />
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#244ADEA2" />
        <SolidColorBrush x:Key="WarningBrush" Color="#FFF6B85A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B7A" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="#20FF6B7A" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F5FC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FFADB7CA" />
        <SolidColorBrush x:Key="SubtleBrush" Color="#FF7F8BA3" />
        <SolidColorBrush x:Key="FocusRingBrush" Color="#FF79D7FF" />

        <LinearGradientBrush x:Key="WindowGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF11151E" />
            <GradientStop Offset="0.55" Color="#FF131823" />
            <GradientStop Offset="1" Color="#FF171B29" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeaderGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#FF202438" />
            <GradientStop Offset="0.55" Color="#FF1B2130" />
            <GradientStop Offset="1" Color="#FF18202C" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Offset="0" Color="#FFA091FF" />
            <GradientStop Offset="1" Color="#FF7468E8" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopAccentGradientBrush"
                             StartPoint="0,0"
                             EndPoint="1,0">
            <GradientStop Offset="0" Color="#008B7CF6" />
            <GradientStop Offset="0.2" Color="#FF8B7CF6" />
            <GradientStop Offset="0.72" Color="#FF63D8FF" />
            <GradientStop Offset="1" Color="#0063D8FF" />
        </LinearGradientBrush>

        <!-- Typography -->
        <Style x:Key="PanelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="EyebrowTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PanelTextStyle}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PanelTextStyle}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PanelTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <Style x:Key="ValueTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource PanelTextStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFDCE5F5" />
        </Style>

        <!-- Buttons share one interaction layer so semantic colors remain intact on hover. -->
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9" />
                            <Border x:Name="HoverTint"
                                    Margin="1"
                                    Background="#18FFFFFF"
                                    CornerRadius="8"
                                    Opacity="0" />
                            <Border x:Name="FocusChrome"
                                    BorderBrush="{StaticResource FocusRingBrush}"
                                    BorderThickness="2"
                                    CornerRadius="9"
                                    Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HoverTint" Property="Background" Value="#20000000" />
                                <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusChrome" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="BorderBrush" Value="#FFB7ACFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="QuietButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FF252D3D" />
            <Setter Property="BorderBrush" Value="#FF3A465B" />
        </Style>

        <Style x:Key="SoftAccentButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="#728B7CF6" />
            <Setter Property="Foreground" Value="#FFE1DCFF" />
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
            <Setter Property="BorderBrush" Value="#70FF6B7A" />
            <Setter Property="Foreground" Value="#FFFFC7CD" />
        </Style>

        <!-- Combo box -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0,34,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border x:Name="Chrome"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="9" />
                                            <Border x:Name="HoverTint"
                                                    Margin="1"
                                                    Background="#12FFFFFF"
                                                    CornerRadius="8"
                                                    Opacity="0" />
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Width="9"
                                                  Height="5"
                                                  Margin="0,0,14,0"
                                                  Stretch="Fill"
                                                  Fill="{StaticResource MutedBrush}"
                                                  Data="M0,0 L4.5,5 L9,0 Z" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"
                                              Margin="13,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   StaysOpen="False">
                                <Border Background="#FF232B3A"
                                        BorderBrush="#FF4A5870"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Margin="0,5,0,0"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20"
                                                          ShadowDepth="7"
                                                          Opacity="0.36"
                                                          Color="#FF000000" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="240"
                                                  SnapsToDevicePixels="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                                <Setter TargetName="ToggleButton" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#FF303A4C" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#4D8B7CF6" />
                                <Setter Property="Foreground" Value="#FFF0EEFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check box -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="20"
                                    Height="20"
                                    Background="{StaticResource ControlBrush}"
                                    BorderBrush="{StaticResource BorderBrushStrong}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Visibility="Collapsed"
                                      Stroke="White"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M4.5,10 L8.5,14 L15.5,6" />
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider -->
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="{TemplateBinding Width}"
                              Height="{TemplateBinding Height}">
                            <Ellipse Fill="#44000000"
                                     Margin="0,2,0,0" />
                            <Ellipse x:Name="ThumbBody"
                                     Fill="#FFF7F8FC"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="3" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBody" Property="Stroke" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBody" Property="Fill" Value="#FFE7E3FF" />
                                <Setter TargetName="ThumbBody" Property="StrokeThickness" Value="4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentGradientBrush}"
                                CornerRadius="999" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6"
                                VerticalAlignment="Center"
                                Background="#FF323B4D"
                                CornerRadius="999" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Height" Value="30" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Border x:Name="FocusChrome"
                                Height="30"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Track x:Name="PART_Track"
                                   Margin="4,0"
                                   IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Style="{StaticResource SliderDecreaseButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Style="{StaticResource SliderIncreaseButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FocusChrome" Property="Background" Value="#108B7CF6" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusChrome" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim, always discoverable scrolling for the narrow docked panel. -->
        <Style x:Key="SlimScrollBarButtonStyle"
               TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarThumbStyle"
               TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbChrome"
                                Margin="1"
                                Background="#FF56647E"
                                CornerRadius="999" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbChrome"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbChrome"
                                        Property="Background"
                                        Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SlimScrollBarStyle"
               TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="#32101720" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Width="{TemplateBinding Width}"
                                Margin="2,0,0,0"
                                Background="{TemplateBinding Background}"
                                CornerRadius="999">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Style="{StaticResource SlimScrollBarButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="28"
                                           Style="{StaticResource SlimScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Style="{StaticResource SlimScrollBarButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panels and cards -->
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SectionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="ControlGroupStyle" TargetType="Border">
            <Setter Property="Background" Value="#8C151B26" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="CharacterCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="AutomationProperties.Name"
                    Value="{Binding AccessibilitySummary}" />
            <Setter Property="AutomationProperties.HelpText"
                    Value="Use arrow keys to select. Press Enter or Space to show or hide. Press Shift+F10 to switch skin." />
            <Setter Property="ToolTip"
                    Value="Enter or Space: show/hide · Shift+F10: switch skin" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 ItemsSource="{Binding AvailableSkins}"
                                 IsEnabled="{Binding CanToggleVisibility}"
                                 AutomationProperties.Name="Switch character skin">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="IsCheckable" Value="True" />
                                <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                                <Setter Property="Command" Value="{x:Static views:MainWindow.SwitchSkinCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                                <Setter Property="CommandTarget" Value="{Binding Source={x:Reference RootWindow}}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="SelectedGlow"
                                    Margin="0"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="12"
                                    Opacity="0" />
                            <Border x:Name="ItemBorder"
                                    Margin="1"
                                    Background="#C9202735"
                                    BorderBrush="#FF354055"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="SelectedRail"
                                    Width="3"
                                    Margin="1,13,0,13"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentHoverBrush}"
                                    CornerRadius="999"
                                    Opacity="0" />
                            <Border x:Name="FocusChrome"
                                    Margin="1"
                                    BorderBrush="{StaticResource FocusRingBrush}"
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    IsHitTestVisible="False"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SectionHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF56647E" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectedGlow" Property="Opacity" Value="1" />
                                <Setter TargetName="SelectedRail" Property="Opacity" Value="1" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF252B3C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusChrome" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource WindowGradientBrush}"
            CornerRadius="22"
            BorderBrush="#FF30394C"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Border Height="3"
                    VerticalAlignment="Top"
                    Background="{StaticResource TopAccentGradientBrush}"
                    Panel.ZIndex="4" />

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header / draggable chrome -->
                <Border Grid.Row="0"
                        Background="{StaticResource HeaderGradientBrush}"
                        BorderBrush="#FF303A4D"
                        BorderThickness="1"
                        CornerRadius="15"
                        Padding="14"
                        Margin="0,2,0,12"
                        MouseLeftButtonDown="OnWindowChromeMouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="42"
                                Height="42"
                                Margin="0,0,12,0"
                                CornerRadius="12"
                                ClipToBounds="True">
                            <Image Source="pack://application:,,,/Assets/Brand/spinepet-avatar.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False"
                                   AutomationProperties.Name="SpinePet white ghost avatar" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center">
                            <TextBlock Text="SpinePet"
                                       FontSize="21"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <StackPanel Margin="0,3,0,0"
                                        Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="ModeLabel"
                                           Text="Configuration Mode"
                                           Style="{StaticResource EyebrowTextStyle}"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{StaticResource InfoSoftBrush}"
                                BorderBrush="#5563D8FF"
                                BorderThickness="1"
                                CornerRadius="999"
                                Padding="10,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6"
                                         Height="6"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center"
                                         Fill="{StaticResource InfoBrush}" />
                                <TextBlock x:Name="CharacterCountText"
                                           Text="{Binding CharacterCountDisplay}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFBCEFFF"
                                           AutomationProperties.Name="{Binding CharacterSearchStatus}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Focusable="False">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar"
                               BasedOn="{StaticResource SlimScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <StackPanel>
                        <!-- Character library -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,10,0"
                                            CornerRadius="9"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Fill="#FFCFC8FF"
                                              Data="M3,2 L9,2 C10.1,2 11,2.9 11,4 L11,5 L13,5 C14.1,5 15,5.9 15,7 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,4 C1,2.9 1.9,2 3,2 Z M3,4 L3,14 L13,14 L13,7 L9,7 L9,4 Z" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="Characters"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Your character library"
                                                   Margin="0,2,0,0"
                                                   Style="{StaticResource EyebrowTextStyle}" />
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource SoftAccentButtonStyle}"
                                            MinWidth="66"
                                            Height="34"
                                            MinHeight="34"
                                            Margin="0,0,8,0"
                                            Padding="10,0"
                                            Click="OnAddCharacter"
                                            ToolTip="Import a Spine character"
                                            AutomationProperties.Name="Add character">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="11"
                                                  Height="11"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="2"
                                                  StrokeStartLineCap="Round"
                                                  Data="M6,1 L6,11 M1,6 L11,6" />
                                            <TextBlock Text="Add" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3"
                                            Style="{StaticResource QuietButtonStyle}"
                                            MinWidth="66"
                                            Height="34"
                                            MinHeight="34"
                                            Padding="10,0"
                                            Click="OnScanResources"
                                            ToolTip="Scan the resource folder"
                                            AutomationProperties.Name="Scan resource folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12"
                                                  Height="12"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  Data="M11,5 A5,5 0 1 0 10,9 M11,5 L11,1 M11,5 L7,5" />
                                            <TextBlock Text="Scan" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="4"
                                            Style="{StaticResource QuietButtonStyle}"
                                            MinWidth="72"
                                            Height="34"
                                            MinHeight="34"
                                            Margin="8,0,0,0"
                                            Padding="10,0"
                                            Click="OnOpenResourceFolder"
                                            ToolTip="Open the resource folder"
                                            AutomationProperties.Name="Open resource folder">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="13"
                                                  Height="11"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  Data="M1,3 L1,11 L13,11 L13,4 L7,4 L6,2 L1,2 Z" />
                                            <TextBlock Text="Folder" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Search"
                                               Margin="2,0,12,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource FieldLabelStyle}" />

                                    <Border Grid.Column="1"
                                            Height="40">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource ControlBrush}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{StaticResource BorderBrushStrong}" />
                                                <Setter Property="BorderThickness"
                                                        Value="1" />
                                                <Setter Property="CornerRadius"
                                                        Value="9" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="#FF5A6882" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin"
                                                             Value="True">
                                                        <Setter Property="BorderBrush"
                                                                Value="{StaticResource FocusRingBrush}" />
                                                        <Setter Property="BorderThickness"
                                                                Value="2" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <TextBox x:Name="CharacterSearchBox"
                                                     Text="{Binding CharacterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="12,0,62,0"
                                                     VerticalContentAlignment="Center"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                                     Foreground="{StaticResource TextPrimaryBrush}"
                                                     FontSize="13"
                                                     SelectionBrush="{StaticResource AccentBrush}"
                                                     SpellCheck.IsEnabled="False"
                                                     ToolTip="Search characters (Ctrl+F). Down or Enter opens results; Esc clears."
                                                     AutomationProperties.Name="Search characters"
                                                     AutomationProperties.HelpText="Filters by character name or skin as you type. Press Down or Enter to move to results. Press Escape to clear.">
                                                <TextBox.InputBindings>
                                                    <KeyBinding Key="Escape"
                                                                Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}" />
                                                    <KeyBinding Key="Down"
                                                                Command="{x:Static views:MainWindow.FocusCharacterResultsCommand}" />
                                                    <KeyBinding Key="Enter"
                                                                Command="{x:Static views:MainWindow.FocusCharacterResultsCommand}" />
                                                </TextBox.InputBindings>
                                            </TextBox>

                                            <TextBlock Text="Name or skin"
                                                       Margin="13,0,62,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="12"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ElementName=CharacterSearchBox, Path=Text.Length}"
                                                                         Value="0">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Button Width="50"
                                                    Height="28"
                                                    MinHeight="28"
                                                    Margin="0,0,6,0"
                                                    Padding="7,0"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}"
                                                    AutomationProperties.Name="Clear character search">
                                                <Button.Style>
                                                    <Style TargetType="Button"
                                                           BasedOn="{StaticResource QuietButtonStyle}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCharacterSearchInput}"
                                                                         Value="True">
                                                                <Setter Property="Visibility"
                                                                        Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="Clear"
                                                           FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <ListBox x:Name="CharacterCards"
                                             ItemsSource="{Binding CharacterView}"
                                             SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                                             SelectionChanged="OnCharacterSelectionChanged"
                                             PreviewMouseWheel="OnCharacterCardsPreviewMouseWheel"
                                             PreviewKeyDown="OnCharacterCardsPreviewKeyDown"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ItemContainerStyle="{StaticResource CharacterCardItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.IsDeferredScrollingEnabled="False"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             VirtualizingPanel.CacheLength="1"
                                             VirtualizingPanel.CacheLengthUnit="Page"
                                             KeyboardNavigation.TabNavigation="Once"
                                             KeyboardNavigation.DirectionalNavigation="Contained"
                                             AutomationProperties.Name="Character library"
                                             MinHeight="216"
                                             MaxHeight="424">
                                        <ListBox.InputBindings>
                                            <KeyBinding Key="Escape"
                                                        Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}" />
                                        </ListBox.InputBindings>
                                        <ListBox.Resources>
                                            <Style TargetType="ScrollBar"
                                                   BasedOn="{StaticResource SlimScrollBarStyle}" />
                                        </ListBox.Resources>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid MinHeight="96"
                                                      Tag="{Binding}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0"
                                                            Width="54"
                                                            Height="88"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="9"
                                                            BorderBrush="#FF3A465D"
                                                            BorderThickness="1"
                                                            ClipToBounds="True">
                                                        <Border.Background>
                                                            <RadialGradientBrush Center="0.5,0.32"
                                                                                 GradientOrigin="0.5,0.32"
                                                                                 RadiusX="0.9"
                                                                                 RadiusY="0.9">
                                                                <GradientStop Offset="0" Color="#FF30354C" />
                                                                <GradientStop Offset="0.62" Color="#FF202737" />
                                                                <GradientStop Offset="1" Color="#FF171C27" />
                                                            </RadialGradientBrush>
                                                        </Border.Background>
                                                        <Image Source="{Binding ThumbnailPath}"
                                                               Margin="3"
                                                               Stretch="Uniform"
                                                               Focusable="False"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>

                                                    <Grid Grid.Column="1"
                                                          Margin="12,1,10,1"
                                                          VerticalAlignment="Center">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="18"
                                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="None"
                                                                   ToolTip="{Binding Name}" />

                                                        <StackPanel Grid.Row="1"
                                                                    Margin="0,6,0,0"
                                                                    Orientation="Horizontal">
                                                             <Border Padding="7,3"
                                                                     CornerRadius="999"
                                                                      Background="#B6221D38"
                                                                     BorderBrush="#668B7CF6"
                                                                     BorderThickness="1">
                                                                <TextBlock Text="{Binding SkinLabel}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="#FFDCD6FF"
                                                                           MaxWidth="92"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            ToolTip="{Binding SkinLabel}" />
                                                             </Border>
                                                         </StackPanel>

                                                        <StackPanel Grid.Row="2"
                                                                    Margin="1,7,0,0"
                                                                    Orientation="Horizontal">
                                                            <Ellipse x:Name="StateDot"
                                                                     Width="7"
                                                                     Height="7"
                                                                     Margin="0,0,6,0"
                                                                     VerticalAlignment="Center"
                                                                     Fill="{StaticResource SubtleBrush}" />
                                                            <TextBlock x:Name="CardStateText"
                                                                       Text="Hidden on desktop"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource MutedBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Button x:Name="VisibilityButton"
                                                            Grid.Column="2"
                                                            Style="{StaticResource BaseButtonStyle}"
                                                            IsEnabled="{Binding CanToggleVisibility}"
                                                            Width="78"
                                                            Height="36"
                                                            MinHeight="36"
                                                            Padding="10,0"
                                                            Click="OnToggleCharacter"
                                                            Tag="{Binding}"
                                                            IsTabStop="False"
                                                            AutomationProperties.Name="{Binding VisibilityActionAutomationLabel}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path x:Name="VisibilityIcon"
                                                                  Width="13"
                                                                  Height="9"
                                                                  Margin="0,0,7,0"
                                                                  Stretch="Uniform"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  Data="M1,5 C3.2,1.4 8.8,1.4 11,5 C8.8,8.6 3.2,8.6 1,5 Z M6,3.3 A1.7,1.7 0 1 1 5.99,3.3" />
                                                            <TextBlock Text="{Binding VisibilityActionLabel}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                        <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                        <Setter TargetName="CardStateText" Property="Text" Value="Visible on desktop" />
                                                        <Setter TargetName="CardStateText" Property="Foreground" Value="#FFB9F6DB" />
                                                        <Setter TargetName="VisibilityButton" Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                                                        <Setter TargetName="VisibilityButton" Property="BorderBrush" Value="#704ADEA2" />
                                                        <Setter TargetName="VisibilityButton" Property="Foreground" Value="#FFC8F8E2" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                        <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource WarningBrush}" />
                                                        <Setter TargetName="CardStateText" Property="Text" Value="Loading" />
                                                        <Setter TargetName="CardStateText" Property="Foreground" Value="#FFFFE4B7" />
                                                        <Setter TargetName="VisibilityIcon" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=CharacterCards, Path=HasItems}"
                                                                       Value="False" />
                                                            <Condition Binding="{Binding HasCharacters}"
                                                                       Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Width="38"
                                                Height="38"
                                                Margin="0,0,0,9"
                                                CornerRadius="12"
                                                Background="{StaticResource AccentSoftBrush}">
                                            <Path Width="18"
                                                  Height="18"
                                                  Stretch="Uniform"
                                                  Stroke="#FFBDB4FF"
                                                  StrokeThickness="1.6"
                                                  Data="M3,2 L9,2 C10.1,2 11,2.9 11,4 L11,5 L13,5 C14.1,5 15,5.9 15,7 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,4 C1,2.9 1.9,2 3,2 Z" />
                                        </Border>
                                        <TextBlock Text="No characters yet"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                AutomationProperties.Name="No matching characters. Try another name or skin."
                                                AutomationProperties.LiveSetting="Polite">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=CharacterCards, Path=HasItems}"
                                                                       Value="False" />
                                                            <Condition Binding="{Binding HasCharacters}"
                                                                       Value="True" />
                                                            <Condition Binding="{Binding HasCharacterSearch}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="No matching characters"
                                                   HorizontalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Try another name or skin."
                                                   Margin="0,4,0,10"
                                                   HorizontalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <Button Content="Clear search"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Height="32"
                                                MinHeight="32"
                                                Padding="12,0"
                                                Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}"
                                                AutomationProperties.Name="Clear character search" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Selected character controls -->
                        <Border Style="{StaticResource SectionBorderStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Margin="0,0,10,0"
                                            CornerRadius="9"
                                            Background="{StaticResource InfoSoftBrush}">
                                        <Path Width="16"
                                              Height="16"
                                              Stretch="Uniform"
                                              Stroke="#FF9BE9FF"
                                              StrokeThickness="1.6"
                                              Data="M8,1 A4,4 0 1 1 7.99,1 M2,15 C2.5,11.7 4.5,10 8,10 C11.5,10 13.5,11.7 14,15" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SELECTED CHARACTER"
                                                   Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding SelectedCharacter.Name, TargetNullValue='No character selected'}"
                                                   Margin="0,3,10,0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="None" />
                                         <WrapPanel Margin="0,5,10,0">
                                             <TextBlock Text="{Binding SelectedCharacter.SkinLabel}"
                                                        FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                        MaxWidth="110"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding SelectedCharacter.SkinLabel}" />
                                         </WrapPanel>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Height="34"
                                            MinHeight="34"
                                            MinWidth="108"
                                            Padding="10,0"
                                            Click="OnResetSelectedPosition"
                                            IsEnabled="{Binding HasSelectedCharacter}"
                                            ToolTip="Move the selected character back to its default position"
                                            AutomationProperties.Name="Reset selected character position">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="12"
                                                  Height="12"
                                                  Margin="0,0,7,0"
                                                  Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round"
                                                  Data="M11,5 A5,5 0 1 0 10,9 M11,5 L11,1 M11,5 L7,5" />
                                            <TextBlock Text="Position" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="ANIMATION"
                                           Margin="1,0,0,7"
                                           Style="{StaticResource EyebrowTextStyle}" />
                                <ComboBox x:Name="AnimationCombo"
                                          ItemsSource="{Binding SelectedAnimationNames}"
                                          SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                                          SelectionChanged="OnAnimationChanged"
                                          IsEnabled="{Binding HasSelectedCharacter}"
                                          AutomationProperties.Name="Character animation"
                                          Margin="0,0,0,12" />

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="MoveSelectedCheckBox"
                                                  Content="Move selected character"
                                                  Checked="OnMoveSelectionChanged"
                                                  Unchecked="OnMoveSelectionChanged"
                                                  IsEnabled="{Binding HasSelectedCharacter}"
                                                  AutomationProperties.Name="Move selected character" />
                                        <Border Grid.Column="1"
                                                Padding="8,4"
                                                CornerRadius="999"
                                                Background="{StaticResource InfoSoftBrush}">
                                            <TextBlock Text="Drag on desktop"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFA9EFFF" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="Desktop frame rate"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="30 saves power; 60 is balanced; 120 suits high-refresh displays"
                                                       Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FrameRateOptions}"
                                                  SelectedItem="{Binding TargetFrameRate, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Desktop pet frame rate in frames per second"
                                                  AutomationProperties.HelpText="Choose 30 for lower power use, 60 for balanced animation, or 120 for high-refresh displays.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0} FPS}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Allow dragging in render mode"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Short clicks still play the action animation"
                                                       Margin="0,3,12,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding AllowRenderDrag, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Allow dragging in render mode" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="13"
                                                      Height="13"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6"
                                                      Data="M1,5 L1,1 L5,1 M11,5 L11,1 L7,1 M1,7 L1,11 L5,11 M11,7 L11,11 L7,11" />
                                                <TextBlock Text="Scale"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="8,3"
                                                    CornerRadius="999"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="{Binding SelectedScaleDisplay}"
                                                           Style="{StaticResource ValueTextStyle}"
                                                           Foreground="#FFDCD6FF" />
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="ScaleSlider"
                                                    Grid.Column="0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    Value="{Binding SelectedScalePercent, Mode=TwoWay}"
                                                    ValueChanged="OnScaleChanged"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Character scale"
                                                    VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="Reset"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Width="62"
                                                    Height="28"
                                                    MinHeight="28"
                                                    Padding="8,0"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="OnResetScale"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Reset character scale" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="13"
                                                      Height="13"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      Data="M2,7 L7,2 M7,2 L7,5 M7,2 L4,2 M7,7 L12,2 M12,2 L12,5" />
                                                <TextBlock Text="Animation Speed"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                            </StackPanel>
                                            <Border Grid.Column="1"
                                                    Padding="8,3"
                                                    CornerRadius="999"
                                                    Background="{StaticResource InfoSoftBrush}">
                                                <TextBlock Text="{Binding SelectedSpeedDisplay}"
                                                           Style="{StaticResource ValueTextStyle}"
                                                           Foreground="#FFC6F2FF" />
                                            </Border>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SpeedSlider"
                                                    Grid.Column="0"
                                                    Minimum="10"
                                                    Maximum="200"
                                                    Value="{Binding SelectedSpeed, Mode=TwoWay}"
                                                    ValueChanged="OnSpeedChanged"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Animation speed"
                                                    VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="Reset"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Width="62"
                                                    Height="28"
                                                    MinHeight="28"
                                                    Padding="8,0"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Click="OnResetSpeed"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Reset animation speed" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Height="38"
                                        Click="OnDeleteSelectedSkin"
                                        IsEnabled="{Binding HasSelectedCharacter}"
                                        ToolTip="Move the selected skin resources to the Recycle Bin"
                                        AutomationProperties.Name="Delete selected skin">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13"
                                              Height="14"
                                              Margin="0,0,8,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              Data="M2,4 L12,4 M5,4 L5,2 L9,2 L9,4 M4,6 L4.7,13 L9.3,13 L10,6 M6.5,7 L6.5,11 M8.5,7 L8.5,11" />
                                        <TextBlock Text="Delete Current Skin" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="44"
                        Margin="0,12,0,0"
                        Click="OnExitConfiguration"
                        Content="Finish Configuration"
                        AutomationProperties.Name="Finish configuration" />
            </Grid>
        </Grid>
    </Border>
</Window>
