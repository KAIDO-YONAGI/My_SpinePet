<Window x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpinePet.Views"
        Title="SpinePet"
        Icon="pack://application:,,,/Assets/Brand/SpinePet.ico"
        Width="1020"
        MinWidth="640"
        MinHeight="560"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#FFF2F2F2"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ResizeMode="CanResize"
        Topmost="True"
        ShowInTaskbar="False"
        AutomationProperties.Name="SpinePet configuration panel">
    <Window.InputBindings>
        <KeyBinding Key="F"
                    Modifiers="Control"
                    Command="{x:Static views:MainWindow.FocusCharacterSearchCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpinePet;component/Themes/ConfigPanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="WindowChrome"
            Background="{StaticResource WindowGradientBrush}"
            CornerRadius="8"
            BorderBrush="#FF303030"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid>
            <Border Height="3"
                    VerticalAlignment="Top"
                    Background="{StaticResource TopAccentGradientBrush}"
                    Panel.ZIndex="4" />

            <Grid Margin="16">
                <!-- Right side acts as one tall column (settings + finish); the library aligns with it. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Left column: character library -->
            <Border Grid.Column="0"
                            Style="{StaticResource SectionBorderStyle}"
                            Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="26"
                                        Height="26"
                                        Margin="0,0,8,0"
                                        CornerRadius="7"
                                        Background="{StaticResource AccentSoftBrush}">
                                    <Path Width="13"
                                          Height="13"
                                          Stretch="Uniform"
                                          Fill="#FFCFC8FF"
                                          Data="M3,2 L9,2 C10.1,2 11,2.9 11,4 L11,5 L13,5 C14.1,5 15,5.9 15,7 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,4 C1,2.9 1.9,2 3,2 Z M3,4 L3,14 L13,14 L13,7 L9,7 L9,4 Z" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Characters"
                                               FontSize="13"
                                               Style="{StaticResource SectionTitleStyle}" />
                                    <Border Margin="0,3,0,0"
                                            Padding="7,2"
                                            CornerRadius="8"
                                            Background="#FFFFFFFF"
                                            HorizontalAlignment="Left">
                                        <TextBlock x:Name="CharacterCountText"
                                                   Text="{Binding CharacterCountDisplay}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FF161616"
                                                   AutomationProperties.Name="{Binding CharacterSearchStatus}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                    </Border>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Style="{StaticResource SoftAccentButtonStyle}"
                                        MinWidth="58"
                                        Height="28"
                                        MinHeight="28"
                                        Margin="0,0,6,0"
                                        Padding="8,0"
                                        x:Name="AddCharacterButton"
                                        ToolTip="Import a Spine character"
                                        AutomationProperties.Name="Add character">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="10"
                                              Height="10"
                                              Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              Data="M6,1 L6,11 M1,6 L11,6" />
                                        <TextBlock Text="Add" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinWidth="58"
                                        Height="28"
                                        MinHeight="28"
                                        Padding="8,0"
                                        x:Name="ScanResourcesButton"
                                        ToolTip="Scan the resource folder"
                                        AutomationProperties.Name="Scan resource folder">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="11"
                                              Height="11"
                                              Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.7"
                                              StrokeStartLineCap="Round"
                                              Data="M11,5 A5,5 0 1 0 10,9 M11,5 L11,1 M11,5 L7,5" />
                                        <TextBlock Text="Scan" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="4"
                                        Style="{StaticResource QuietButtonStyle}"
                                        MinWidth="64"
                                        Height="28"
                                        MinHeight="28"
                                        Margin="6,0,0,0"
                                        Padding="8,0"
                                        x:Name="OpenResourceFolderButton"
                                        ToolTip="Open the resource folder"
                                        AutomationProperties.Name="Open resource folder">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12"
                                              Height="10"
                                              Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeLineJoin="Round"
                                              Data="M1,3 L1,11 L13,11 L13,4 L7,4 L6,2 L1,2 Z" />
                                        <TextBlock Text="Folder" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Search + thumbnail size slider -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Height="32"
                                        Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"
                                                    Value="{StaticResource ControlBrush}" />
                                            <Setter Property="BorderBrush"
                                                    Value="{StaticResource BorderBrushStrong}" />
                                            <Setter Property="BorderThickness"
                                                    Value="1" />
                                            <Setter Property="CornerRadius"
                                                    Value="9" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver"
                                                         Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="#FF5A5A5A" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocusWithin"
                                                         Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{StaticResource FocusRingBrush}" />
                                                    <Setter Property="BorderThickness"
                                                            Value="2" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <TextBox x:Name="CharacterSearchBox"
                                                 Text="{Binding CharacterSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="12,0,62,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 CaretBrush="{StaticResource TextPrimaryBrush}"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 FontSize="13"
                                                 SelectionBrush="{StaticResource AccentBrush}"
                                                 SpellCheck.IsEnabled="False"
                                                 ToolTip="Search characters (Ctrl+F). Down or Enter opens results; Esc clears."
                                                 AutomationProperties.Name="Search characters"
                                                 AutomationProperties.HelpText="Filters by character name or skin as you type. Press Down or Enter to move to results. Press Escape to clear.">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Escape"
                                                            Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}" />
                                                <KeyBinding Key="Down"
                                                            Command="{x:Static views:MainWindow.FocusCharacterResultsCommand}" />
                                                <KeyBinding Key="Enter"
                                                            Command="{x:Static views:MainWindow.FocusCharacterResultsCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>

                                        <TextBlock Text="Name or skin"
                                                   Margin="13,0,62,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="11"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=CharacterSearchBox, Path=Text.Length}"
                                                                     Value="0">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Button Width="50"
                                                Height="28"
                                                MinHeight="28"
                                                Margin="0,0,6,0"
                                                Padding="7,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}"
                                                AutomationProperties.Name="Clear character search">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource QuietButtonStyle}">
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCharacterSearchInput}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Clear"
                                                       FontSize="11" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            ToolTip="Adjust the size of preview items in the library list"
                                            AutomationProperties.Name="Library preview size">
                                    <Path Width="13"
                                          Height="13"
                                          Margin="0,0,7,0"
                                          VerticalAlignment="Center"
                                          Stretch="Uniform"
                                          Stroke="{StaticResource MutedBrush}"
                                          StrokeThickness="1.6"
                                          Data="M4,12 L4,10 L2,10 L2,12 Z M7,12 L7,7 L5,7 L5,12 Z M10,12 L10,4 L8,4 L8,12 Z M13,12 L13,2 L11,2 L11,12 Z" />
                                    <Slider Width="90"
                                            Minimum="50"
                                            Maximum="150"
                                            SmallChange="5"
                                            LargeChange="10"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding ThumbnailScalePercent, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Library preview size percent" />
                                    <Border Padding="7,3"
                                            MinWidth="50"
                                            Margin="7,0,0,0"
                                            CornerRadius="8"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="{Binding ThumbnailScaleDisplay}"
                                                   Style="{StaticResource ValueTextStyle}"
                                                   Foreground="#FFDCDCDC"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <ListBox x:Name="CharacterCards"
                                         ItemsSource="{Binding CharacterView}"
                                         SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"

                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemContainerStyle="{StaticResource CharacterCardItemStyle}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="False"
                                         ScrollViewer.IsDeferredScrollingEnabled="False"
                                         ScrollViewer.PanningMode="VerticalOnly"
                                         KeyboardNavigation.TabNavigation="Once"
                                         KeyboardNavigation.DirectionalNavigation="Contained"
                                         AutomationProperties.Name="Character library"
                                         MinHeight="216">
                                    <ListBox.InputBindings>
                                        <KeyBinding Key="Escape"
                                                    Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}" />
                                    </ListBox.InputBindings>
                                    <ListBox.Resources>
                                        <Style TargetType="ScrollBar"
                                               BasedOn="{StaticResource SlimScrollBarStyle}" />
                                    </ListBox.Resources>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinHeight="70"
                                                  Tag="{Binding}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                        Width="{Binding ThumbnailFrameWidth}"
                                                        Height="{Binding ThumbnailFrameHeight}"
                                                        Margin="0,0,12,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        CornerRadius="8"
                                                        BorderBrush="#FF3A3A3A"
                                                        BorderThickness="1"
                                                        ClipToBounds="True">
                                                    <Border.Background>
                                                        <RadialGradientBrush Center="0.5,0.32"
                                                                             GradientOrigin="0.5,0.32"
                                                                             RadiusX="0.9"
                                                                             RadiusY="0.9">
                                                            <GradientStop Offset="0" Color="#FF303030" />
                                                            <GradientStop Offset="0.62" Color="#FF202020" />
                                                            <GradientStop Offset="1" Color="#FF171717" />
                                                        </RadialGradientBrush>
                                                    </Border.Background>
                                                    <Image Source="{Binding ThumbnailPath}"
                                                           Margin="3"
                                                           Stretch="Uniform"
                                                           Focusable="False"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>

                                                <Grid Grid.Column="1"
                                                      Margin="12,0,10,0"
                                                      VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               LineHeight="17"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="None"
                                                               ToolTip="{Binding Name}" />

                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding SkinLabel}"
                                                               Margin="1,2,0,0"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"
                                                               MaxWidth="120"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding SkinLabel}" />

                                                    <StackPanel Grid.Row="2"
                                                                Margin="1,3,0,0"
                                                                Orientation="Horizontal">
                                                        <Border x:Name="StateDot"
                                                                Width="8"
                                                                Height="4"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center"
                                                                CornerRadius="8"
                                                                Background="{StaticResource SubtleBrush}" />
                                                        <TextBlock x:Name="CardStateText"
                                                                   Text="Hidden on desktop"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource MutedBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel Grid.Column="2"
                                                            VerticalAlignment="Center">
                                                    <Button x:Name="VisibilityButton"
                                                            Style="{StaticResource DetailActionButtonStyle}"
                                                            IsEnabled="{Binding CanToggleVisibility}"
                                                            Tag="{Binding}"
                                                            IsTabStop="False"
                                                            AutomationProperties.Name="{Binding VisibilityActionAutomationLabel}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path x:Name="VisibilityIcon"
                                                                  Width="13"
                                                                  Height="9"
                                                                  Margin="0,0,7,0"
                                                                  Stretch="Uniform"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  Data="M1,5 C3.2,1.4 8.8,1.4 11,5 C8.8,8.6 3.2,8.6 1,5 Z M6,3.3 A1.7,1.7 0 1 1 5.99,3.3" />
                                                            <TextBlock Text="{Binding VisibilityActionLabel}" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource DetailActionButtonStyle}"
                                                            Margin="0,5,0,0"
                                                            Tag="{Binding}"
                                                            IsTabStop="False"
                                                            ToolTip="Move this character back to its default position"
                                                            AutomationProperties.Name="Reset character position">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Width="11"
                                                                  Height="11"
                                                                  Margin="0,0,5,0"
                                                                  Stretch="Uniform"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                  StrokeThickness="1.7"
                                                                  StrokeStartLineCap="Round"
                                                                  Data="M11,5 A5,5 0 1 0 10,9 M11,5 L11,1 M11,5 L7,5" />
                                                            <TextBlock Text="Position" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                                                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource SuccessBrush}" />
                                                    <Setter TargetName="CardStateText" Property="Text" Value="Visible on desktop" />
                                                    <Setter TargetName="CardStateText" Property="Foreground" Value="#FFBDBDBD" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                    <Setter TargetName="StateDot" Property="Background" Value="{StaticResource WarningBrush}" />
                                                    <Setter TargetName="CardStateText" Property="Text" Value="Loading" />
                                                    <Setter TargetName="CardStateText" Property="Foreground" Value="#FFE0E0E0" />
                                                    <Setter TargetName="VisibilityIcon" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CharacterCards, Path=HasItems}"
                                                                   Value="False" />
                                                        <Condition Binding="{Binding HasCharacters}"
                                                                   Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="38"
                                            Height="38"
                                            Margin="0,0,0,9"
                                            CornerRadius="8"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <Path Width="18"
                                              Height="18"
                                              Stretch="Uniform"
                                              Stroke="#FFBDBDBD"
                                              StrokeThickness="1.6"
                                              Data="M3,2 L9,2 C10.1,2 11,2.9 11,4 L11,5 L13,5 C14.1,5 15,5.9 15,7 L15,14 C15,15.1 14.1,16 13,16 L3,16 C1.9,16 1,15.1 1,14 L1,4 C1,2.9 1.9,2 3,2 Z" />
                                    </Border>
                                    <TextBlock Text="No characters yet"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            AutomationProperties.Name="No matching characters. Try another name or skin."
                                            AutomationProperties.LiveSetting="Polite">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ElementName=CharacterCards, Path=HasItems}"
                                                                   Value="False" />
                                                        <Condition Binding="{Binding HasCharacters}"
                                                                   Value="True" />
                                                        <Condition Binding="{Binding HasCharacterSearch}"
                                                                   Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="No matching characters"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Try another name or skin."
                                               Margin="0,4,0,10"
                                               HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <Button Content="Clear search"
                                            Style="{StaticResource QuietButtonStyle}"
                                            Height="32"
                                            MinHeight="32"
                                            Padding="12,0"
                                            Command="{x:Static views:MainWindow.ClearCharacterSearchCommand}"
                                            AutomationProperties.Name="Clear character search" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right big column: settings scroll plus the finish button below it. -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Selected character settings, scrolls independently -->
                        <Border Grid.Row="0"
                                Style="{StaticResource SectionBorderStyle}"
                                Margin="0,0,0,0"
                                Padding="12">
                        <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="26"
                                            Height="26"
                                            Margin="0,0,8,0"
                                            CornerRadius="7"
                                            Background="{StaticResource InfoSoftBrush}">
                                        <Path Width="13"
                                              Height="13"
                                              Stretch="Uniform"
                                              Stroke="#FF9BE9FF"
                                              StrokeThickness="1.6"
                                              Data="M8,1 A4,4 0 1 1 7.99,1 M2,15 C2.5,11.7 4.5,10 8,10 C11.5,10 13.5,11.7 14,15" />
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="SELECTED CHARACTER"
                                                   Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{Binding SelectedCharacter.Name, TargetNullValue='No character selected'}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Left"
                                                   MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedCharacter.Name}" />
                                        <WrapPanel Margin="0,3,10,0">
                                            <TextBlock Text="{Binding SelectedCharacter.SkinLabel}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       MaxWidth="260"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SelectedCharacter.SkinLabel}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="ANIMATION"
                                           Margin="1,0,0,6"
                                           Style="{StaticResource EyebrowTextStyle}" />
                                <ComboBox x:Name="AnimationCombo"
                                          ItemsSource="{Binding SelectedAnimationNames}"
                                          SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                                          IsEnabled="{Binding HasSelectedCharacter}"
                                          Height="32"
                                          AutomationProperties.Name="Character animation"
                                          Margin="0,0,0,6" />

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="88" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="Desktop frame rate"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding FrameRateOptions}"
                                                  SelectedItem="{Binding TargetFrameRate, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Height="28"
                                                  AutomationProperties.Name="Desktop pet frame rate in frames per second"
                                                  AutomationProperties.HelpText="Choose 30 for lower power use, 60 for balanced animation, or 120 for high-refresh displays.">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding StringFormat={}{0} FPS}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Allow dragging in render mode"
                                                       Style="{StaticResource FieldLabelStyle}" />
                                            <TextBlock Text="Short clicks still play the action animation"
                                                       Margin="0,2,12,0"
                                                       FontSize="10.5"
                                                       Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding AllowRenderDrag, Mode=TwoWay}"
                                                  x:Name="AllowDraggingToggle"
                                                  VerticalAlignment="Center"
                                                  AutomationProperties.Name="Allow dragging in render mode" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Path Width="13"
                                                      Height="13"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6"
                                                      Data="M1,5 L1,1 L5,1 M11,5 L11,1 L7,1 M1,7 L1,11 L5,11 M11,7 L11,11 L7,11" />
                                                <TextBlock Text="Scale"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Reset"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Width="52"
                                                    Height="24"
                                                    MinHeight="24"
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    x:Name="ResetScaleButton"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Reset character scale" />
                                        </Grid>

                                        <!-- Base size 0-100 (maps to 0-20% actual) -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="0"
                                                    Maximum="100"
                                                    SmallChange="1"
                                                    LargeChange="10"
                                                    Value="{Binding SelectedScaleBasePercent, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Character base scale percent"
                                                    VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource SliderValueBadgeStyle}"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SelectedScaleBasePercentDisplay}"
                                                           Style="{StaticResource ValueTextStyle}"
                                                           Foreground="#FFC6C6C6"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Multiplier 1-5x -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0"
                                                    Minimum="1"
                                                    Maximum="5"
                                                    SmallChange="0.1"
                                                    LargeChange="1"
                                                    Value="{Binding SelectedScaleMultiplier, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Character scale multiplier"
                                                    VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource SliderValueBadgeStyle}"
                                                    Margin="8,0,0,0">
                                                <TextBlock Text="{Binding SelectedScaleMultiplierDisplay}"
                                                           Style="{StaticResource ValueTextStyle}"
                                                           Foreground="#FFC6C6C6"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ControlGroupStyle}"
                                        Margin="0,0,0,6">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Path Width="13"
                                                      Height="13"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource MutedBrush}"
                                                      StrokeThickness="1.6"
                                                      StrokeStartLineCap="Round"
                                                      Data="M2,7 L7,2 M7,2 L7,5 M7,2 L4,2 M7,7 L12,2 M12,2 L12,5" />
                                                <TextBlock Text="Animation Speed"
                                                           Style="{StaticResource FieldLabelStyle}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Content="Reset"
                                                    Style="{StaticResource QuietButtonStyle}"
                                                    Width="52"
                                                    Height="24"
                                                    MinHeight="24"
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    x:Name="ResetSpeedButton"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Reset animation speed" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="SpeedSlider"
                                                    Grid.Column="0"
                                                    Minimum="10"
                                                    Maximum="200"
                                                    Value="{Binding SelectedSpeed, Mode=TwoWay}"
                                                    IsEnabled="{Binding HasSelectedCharacter}"
                                                    AutomationProperties.Name="Animation speed"
                                                    VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Style="{StaticResource SliderValueBadgeStyle}"
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding SelectedSpeedDisplay}"
                                                           Style="{StaticResource ValueTextStyle}"
                                                           Foreground="#FFC6C6C6"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource DangerButtonStyle}"
                                        Height="30"
                                        x:Name="DeleteSkinButton"
                                        IsEnabled="{Binding HasSelectedCharacter}"
                                        ToolTip="Move the selected skin resources to the Recycle Bin"
                                        AutomationProperties.Name="Delete selected skin">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="12"
                                              Height="12"
                                              Margin="0,0,6,0"
                                              Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.6"
                                              StrokeStartLineCap="Round"
                                              Data="M2,4 L12,4 M5,4 L5,2 L9,2 L9,4 M4,6 L4.7,13 L9.3,13 L10,6 M6.5,7 L6.5,11 M8.5,7 L8.5,11" />
                                        <TextBlock Text="Delete Current Skin" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Button Grid.Row="1"
                                Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="36"
                                x:Name="FinishConfigurationButton"
                                Content="Finish Configuration"
                                AutomationProperties.Name="Finish configuration" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
