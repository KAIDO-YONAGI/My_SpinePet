<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SpinePet.Views">

    <!-- Color system: neutral grayscale -->
    <SolidColorBrush x:Key="PanelBrush" Color="#FF121212" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#FF181818" />
    <SolidColorBrush x:Key="SectionBrush" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="SectionHoverBrush" Color="#FF232323" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FF262626" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="BorderBrushStrong" Color="#FF484848" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2EF0F0F0" />
    <SolidColorBrush x:Key="InfoBrush" Color="#FFDADADA" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#1FDADADA" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FFE3E3E3" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#24E3E3E3" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#20EAEAEA" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFADADAD" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#FF808080" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="WindowGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF121212" />
        <GradientStop Offset="0.55" Color="#FF151515" />
        <GradientStop Offset="1" Color="#FF181818" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FF202020" />
        <GradientStop Offset="0.55" Color="#FF1C1C1C" />
        <GradientStop Offset="1" Color="#FF191919" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFF2F2F2" />
        <GradientStop Offset="1" Color="#FFD8D8D8" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopAccentGradientBrush"
                         StartPoint="0,0"
                         EndPoint="1,0">
        <GradientStop Offset="0" Color="#00FFFFFF" />
        <GradientStop Offset="0.2" Color="#FFFFFFFF" />
        <GradientStop Offset="0.72" Color="#FFDCDCDC" />
        <GradientStop Offset="1" Color="#00DCDCDC" />
    </LinearGradientBrush>

    <!-- Typography -->
    <Style x:Key="PanelTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="EyebrowTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelTextStyle}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>

    <Style x:Key="SectionTitleStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelTextStyle}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="FieldLabelStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="ValueTextStyle"
           TargetType="TextBlock"
           BasedOn="{StaticResource PanelTextStyle}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFDCE5F5" />
    </Style>

    <!-- Buttons share one interaction layer so semantic colors remain intact on hover. -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                        <Border x:Name="HoverTint"
                                Margin="1"
                                Background="#18FFFFFF"
                                CornerRadius="8"
                                Opacity="0" />
                        <Border x:Name="FocusChrome"
                                BorderBrush="{StaticResource FocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HoverTint" Property="Background" Value="#20000000" />
                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusChrome" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
        <Setter Property="BorderBrush" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="#FF161616" />
    </Style>

    <Style x:Key="QuietButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#FF262626" />
        <Setter Property="BorderBrush" Value="#FF3B3B3B" />
    </Style>

    <Style x:Key="SoftAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="#72F0F0F0" />
        <Setter Property="Foreground" Value="#FFE8E8E8" />
    </Style>

    <Style x:Key="DangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="BorderBrush" Value="#70EAEAEA" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <!-- Combo box -->
    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0,34,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Foreground="{TemplateBinding Foreground}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Chrome"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8" />
                                        <Border x:Name="HoverTint"
                                                Margin="1"
                                                Background="#12FFFFFF"
                                                CornerRadius="8"
                                                Opacity="0" />
                                        <Path HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Width="9"
                                              Height="5"
                                              Margin="0,0,14,0"
                                              Stretch="Fill"
                                              Fill="{StaticResource MutedBrush}"
                                              Data="M0,0 L4.5,5 L9,0 Z" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="HoverTint" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          IsHitTestVisible="False"
                                          Margin="13,0,34,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left" />
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Fade"
                               StaysOpen="False">
                            <Border Background="#FF232323"
                                    BorderBrush="#FF4A4A4A"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,5,0,0"
                                    Padding="4"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20"
                                                      ShadowDepth="7"
                                                      Opacity="0.36"
                                                      Color="#FF000000" />
                                </Border.Effect>
                                <ScrollViewer MaxHeight="240"
                                              SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                            <Setter TargetName="ToggleButton" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ItemChrome"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="#FF303030" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemChrome" Property="Background" Value="#4DF0F0F0" />
                            <Setter Property="Foreground" Value="#FF161616" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Check box -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box"
                                Width="20"
                                Height="20"
                                Background="{StaticResource ControlBrush}"
                                BorderBrush="{StaticResource BorderBrushStrong}"
                                BorderThickness="1"
                                CornerRadius="8"
                                VerticalAlignment="Center">
                            <Path x:Name="CheckMark"
                                  Visibility="Collapsed"
                                  Stroke="White"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M4.5,10 L8.5,14 L15.5,6" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}">
                        <Border Background="#44000000"
                                CornerRadius="8"
                                Margin="0,2,0,0" />
                        <Border x:Name="ThumbBody"
                                Background="#FFF7F7F7"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="3"
                                CornerRadius="8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBody" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBody" Property="Background" Value="#FFE7E7E7" />
                            <Setter TargetName="ThumbBody" Property="BorderThickness" Value="4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderDecreaseButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="6"
                            VerticalAlignment="Center"
                            Background="#FF323232"
                            CornerRadius="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Height" Value="30" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border x:Name="FocusChrome"
                            Height="30"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8">
                        <Track x:Name="PART_Track"
                               Margin="4,0"
                               IsDirectionReversed="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                              Style="{StaticResource SliderDecreaseButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                              Style="{StaticResource SliderIncreaseButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FocusChrome" Property="Background" Value="#108B7CF6" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusChrome" Property="BorderBrush" Value="{StaticResource FocusRingBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim, always discoverable scrolling for the narrow docked panel. -->
    <Style x:Key="SlimScrollBarButtonStyle"
           TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBarThumbStyle"
           TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbChrome"
                            Margin="1"
                            Background="#FF575757"
                            CornerRadius="8" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome"
                                    Property="Background"
                                    Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbChrome"
                                    Property="Background"
                                    Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SlimScrollBarStyle"
           TargetType="ScrollBar">
        <Setter Property="Width" Value="9.6" />
        <Setter Property="MinWidth" Value="9.6" />
        <Setter Property="Background" Value="#32101010" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Width="{TemplateBinding Width}"
                            Margin="2,0,0,0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <Track x:Name="PART_Track"
                               Orientation="{TemplateBinding Orientation}"
                               IsDirectionReversed="True"
                               Focusable="False">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Style="{StaticResource SlimScrollBarButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb MinHeight="28"
                                       Style="{StaticResource SlimScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Style="{StaticResource SlimScrollBarButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Panels and cards -->
    <Style x:Key="SectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SectionBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="ControlGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="#8C161616" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="CharacterCardItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AutomationProperties.Name"
                Value="{Binding AccessibilitySummary}" />
        <Setter Property="AutomationProperties.HelpText"
                Value="Use arrow keys to select. Press Enter or Space to show or hide. Press Shift+F10 to switch skin." />
        <Setter Property="ToolTip"
                Value="Enter or Space: show/hide · Shift+F10: switch skin" />
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             ItemsSource="{Binding AvailableSkins}"
                             IsEnabled="{Binding CanToggleVisibility}"
                             AutomationProperties.Name="Switch character skin">
                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Label}" />
                            <Setter Property="IsCheckable" Value="True" />
                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=OneWay}" />
                            <Setter Property="Command" Value="{x:Static views:MainWindow.SwitchSkinCommand}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="CommandTarget"
                                    Value="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="SelectedGlow"
                                Margin="0"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                        <Border x:Name="ItemBorder"
                                Margin="1"
                                Background="#C9202020"
                                BorderBrush="#FF363636"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="SelectedRail"
                                Width="3"
                                Margin="1,13,0,13"
                                HorizontalAlignment="Left"
                                Background="{StaticResource AccentHoverBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                        <Border x:Name="FocusChrome"
                                Margin="1"
                                BorderBrush="{StaticResource FocusRingBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SectionHoverBrush}" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF575757" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectedGlow" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectedRail" Property="Opacity" Value="1" />
                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            <Setter TargetName="ItemBorder" Property="Background" Value="#FF262626" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusChrome" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
